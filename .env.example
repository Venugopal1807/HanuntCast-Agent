VOICE_PROVIDER=mock
DEPLOYMENT_MODE=local
# Live playback also requires a private proxy token and an existing cumulative ledger.
# Never put this token in frontend variables, requests made by browser code, or Git.
TTS_LIVE_ACCESS_TOKEN=
TTS_BUDGET_PATH=
STORY_PROVIDER=demo
# Backend only. Leave blank for a process-local random signing key.
JWT_SECRET=
# Backend only. Safe local placeholder; it is rejected by both live transports.
# Keep VOICE_PROVIDER=mock for local development. To enable paid live playback later,
# configure TTS_LIVE_ACCESS_TOKEN (injected by a private reverse proxy) and an existing TTS_BUDGET_PATH ledger,
# replace this value privately, set VOICE_PROVIDER=assemblyai and restart FastAPI.
# Never put a key in VITE_* variables or frontend code. Public hosting stays mock-only.
ASSEMBLYAI_API_KEY=dummy_assemblyai_key_local_only

# Verified English library voices; allowed: aai-george, aai-jane, aai-audrey.
ASSEMBLYAI_VOICE_ARCHIVIST=aai-george
ASSEMBLYAI_VOICE_SKEPTIC=aai-jane
ASSEMBLYAI_VOICE_MEDIUM=aai-audrey
# Never enable this for routine tests: exactly one paid HTTP WAV synthesis.
HAUNTCAST_LIVE_SMOKE=0
